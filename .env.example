# hc_weda - Environment Configuration Example
# Kopiere diese Datei zu .env und passe die Werte an

APP_NAME=hc_weda
APP_VERSION=2.0.0

# ----------- HTTP Server -----------
# Im Container läuft die App auf Port 5045
# Von außen erreichbar über docker-compose.yml Port-Mapping
HOST=0.0.0.0
PORT=5045
APPLICATION_ROOT=/

# ----------- Logging -----------
LOG_LEVEL=INFO
LOG_MODE=console
LOG_FILE=logs/hc_weda.log
LOG_MAX_BYTES=1000000
LOG_BACKUP_COUNT=3

# ----------- MQTT -----------
MQTT_BROKER=your-mqtt-broker-ip
MQTT_PORT=1883
MQTT_USER=your-mqtt-user
MQTT_PASS=your-mqtt-password

# ----------- Home Assistant -----------
HA_BASETOPIC=hc_weda
HA_DISCOVERY=homeassistant

# ----------- Webhook -----------
# Home Assistant Webhook für Events (app_start, weather_data, weather_alert)
HA_WEBHOOK_URL=http://your-homeassistant-ip:8123
HA_WEBHOOK_ID=hc_weda

# ----------- KPI Dashboard -----------
KPI_APP_ID=hc_weda
KPI_APP_NAME=Wetterstation
KPI_ICON=thermostat
KPI_URL=http://nuc:5021

# ----------- Database -----------
DB_PATH=data/weather.db

# ----------- Devices (enable/disable) -----------
# Welche Geräte sollen aktiv sein?
DEVICE_SAINLOGIC_WS3500_ENABLED=true

# ----------- Device URLs -----------
# Sainlogic WS3500 Wetterstation (HTTP Receiver)
# Die Wetterstation sendet Daten an diesen Port
DEVICE_WETTERSTATION_HTTP_PORT=8089
DEVICE_WETTERSTATION_HTTP_URL=/weatherstation

# ----------- Weather Forecast -----------
# Open-Meteo API (https://open-meteo.com) - KOSTENLOS, kein API-Key nötig
# Koordinaten für Wettervorhersage
OPENWEATHER_LAT=47.1234567
OPENWEATHER_LON=9.1234567
OPENWEATHER_UNITS=metric

# ----------- Weather Underground (optional, deaktiviert) -----------
# Falls du Daten an Weather Underground senden möchtest
ENABLE_WU=false
WU_ID=your-station-id
WU_PASSWORD=your-station-password
WU_URL=https://weatherstation.wunderground.com/weatherstation/updateweatherstation.php?

# ----------- LAN Targets (optional, deaktiviert) -----------
# Falls du Daten an andere LAN-Ziele senden möchtest (kommagetrennt)
ENABLE_LAN=false
LAN_TARGETS=

# ----------- Wetter-Warnungen -----------
# Schwellwerte für automatische Warnungen (Webhooks an Home Assistant)
# Sturm-Warnung
ALERT_STORM_WIND=50.0          # km/h - Windgeschwindigkeit
ALERT_STORM_GUST=70.0          # km/h - Böen
# Regen-Warnung
ALERT_HEAVY_RAIN=10.0          # mm/h - Regenrate
# Frost-Warnungen
ALERT_FROST=0.0                # °C - Frost (≤ 0°C)
ALERT_FREEZE_RISK=3.0          # °C - Frostgefahr (≤ 3°C)
# Hysterese (verhindert Flapping)
ALERT_MIN_DURATION=15          # Minuten - Warnung bleibt mindestens so lange aktiv
ALERT_COOLDOWN=5               # Minuten - Pause nach Deaktivierung
